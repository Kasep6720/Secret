		["M"] = 1e6,       -- 1,000,000
		["B"] = 1e9,       -- 1,000,000,000
		["T"] = 1e12,      -- 1,000,000,000,000
		["Qd"] = 1e15,     -- 1,000,000,000,000,000
	}
	local function ShortToNumber(inputString)
		inputString = string.gsub(inputString, "%s+", "")
		local numPart, suffixPart = string.match(inputString, "^([%d%.]+)(%a*)$")
		if numPart then
			local number = tonumber(numPart)
			if suffixPart and suffixes[suffixPart] then
				return number * suffixes[suffixPart]
			else
				return number
			end
		end
		return 0
	end
	local function CleanToNumber(inputString)
		local cleanString = string.gsub(inputString, "%D", "")
		return tonumber(cleanString) or 0
	end
	local function parseCurrency(text: string): number
		local cleanText = string.gsub(text, "[$,%s]", "")
		return tonumber(cleanText) or 0
