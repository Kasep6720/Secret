	--Wait for stuff to load
	local function waitForGridToLoad(gridInstance, expectedMin)
		local isLoaded = false
		local bindableEvent = Instance.new("BindableEvent")
		local function checkProgress()
			if isLoaded then return end
			local currentChildCount = #gridInstance:GetChildren()
			
			if currentChildCount >= expectedMin then
				task.wait(0.5) -- 防斷流延遲確認
				if currentChildCount == #gridInstance:GetChildren() then
					isLoaded = true
					bindableEvent:Fire()
				end
			end
		end
		local connection = gridInstance.ChildAdded:Connect(checkProgress)
		checkProgress()
		if not isLoaded then
			bindableEvent.Event:Wait()
		end	
		connection:Disconnect()
		bindableEvent:Destroy()
	end
